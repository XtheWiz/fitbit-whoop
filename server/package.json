{
  "name": "@recover/server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "seed": "bun run src/db/seed.ts",
    "summaries:run": "bun run src/jobs/summaries_run.ts"
  },
  "dependencies": {
    "@recover/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
