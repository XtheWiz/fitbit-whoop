# Server
PORT=3000
DATABASE_URL=postgres://recover:recover@localhost:5432/recover

# AI assistant (provider-agnostic). Pick one provider.
AI_PROVIDER=zai               # zai | gemini | claude | template (keyless default)

# z.ai (Zhipu GLM) — OpenAI-compatible. Get a key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6             # or glm-5.2, glm-4.7, glm-4.5

# Other providers (future)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
