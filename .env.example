# Server
PORT=3000
DATABASE_URL=postgres://recover:recover@localhost:5432/recover

# AI assistant (provider-agnostic). Pick one provider.
AI_PROVIDER=gemini            # gemini | zai | claude | template (keyless default)

# Google Gemini — OpenAI-compatible endpoint. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash # or gemini-2.5-pro, gemini-2.0-flash

# z.ai (Zhipu GLM) — OpenAI-compatible. Key from https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6             # or glm-5.2, glm-4.7, glm-4.5

# Other providers (future)
ANTHROPIC_API_KEY=
